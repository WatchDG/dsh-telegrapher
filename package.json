{
  "name": "dsh-telegrapher",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Telegrapher token economy for DeepSeek Harness: prompt rules that cut output and thinking tokens, measured against real DSH sessions with tiktoken.",
  "license": "Apache-2.0",
  "author": "Baranov Grigoriy Vladimirovich",
  "homepage": "https://github.com/WatchDG/dsh-telegrapher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WatchDG/dsh-telegrapher.git"
  },
  "bugs": {
    "url": "https://github.com/WatchDG/dsh-telegrapher/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "telegrapher",
    "token-saving",
    "tiktoken",
    "prompt-rules",
    "cordis"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "tools/*.py",
    "docs/*.md",
    "scripts/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test test/catalogue.test.mjs test/detect.test.mjs test/digest.test.mjs test/analysis.test.mjs test/hypotheses.test.mjs test/tool.test.mjs test/client.test.mjs test/plugin.test.mjs test/manifest.test.mjs",
    "test:integration": "node --test test/tiktoken.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
